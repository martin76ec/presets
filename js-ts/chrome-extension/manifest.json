{
  "manifest_version": 3,
  "name": "$PROJECT_NAME",
  "version": "1.0.0",
  "description": "A Chrome extension project setup with Vite, TypeScript, and Tailwind CSS.",
  "permissions": [],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
